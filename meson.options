option('extra_debug', type: 'boolean', value: false,
  description: 'Additional non-standard debug options')
option('tests', type: 'boolean', value: true,
  description: 'Build unit tests')
option('docs', type: 'feature', value: 'auto',
  description: 'Build documentation')

# seat management
option('libseat', type: 'feature', value: 'disabled',
  description: 'Use libseat to integrate with systemd-logind, elogind, or seatd')

# video backends
option('video_fbdev', type: 'feature', value: 'auto',
  description: 'fbdev video backend')
option('video_drm2d', type: 'feature', value: 'auto',
  description: 'drm2d video backend')
option('video_drm3d', type: 'feature', value: 'auto',
  description: 'drm3d video backend')

# renderers
option('renderer_gltex', type: 'feature', value: 'auto',
  description: 'gltex renderer')

# font backends
option('font_psf', type: 'feature', value: 'auto',
  description: 'PC Screen font backend')
option('font_unifont', type: 'feature', value: 'auto',
  description: 'unifont font backend')
option('font_freetype', type: 'feature', value: 'auto',
  description: 'freetype font backend')
option('font_pango', type: 'feature', value: 'auto',
  description: 'pango font backend')

# images (ADR-103)
option('images', type: 'feature', value: 'auto',
  description: 'Sixel and the kitty graphics protocol, with the image helper (libpng, zlib)')

# the session's user for the image helper (ADR-103)
option('sd_login', type: 'feature', value: 'auto',
  description: 'Find the image helper\'s user through sd-login (libsystemd or libelogind)')

# dbus integration
option('dbus', type: 'feature', value: 'auto',
  description: 'dbus integration')

# TERM default value
option('term', type: 'string', value: 'kmscon',
  description: 'default $TERM value')

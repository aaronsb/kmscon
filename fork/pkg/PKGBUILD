# kmscon fork, packaged from a working checkout
#
# Builds the checkout at $KMSCON_SRC (the repository root when built through
# `make pkg`, see fork/tier3.mk), not a release tarball, so the package is
# exactly the tree under test, uncommitted changes included. The libtsm fork is
# a static meson subproject, as in the root Makefile, and nothing from it is
# installed. The split mirrors Arch's kmscon package: the terminfo entry lives
# in its own package so other systems' terminals can install it alone.
#
# The options match Arch's arch-meson wrapper except --wrap-mode: arch-meson
# forbids downloads, and the libtsm subproject is fetched from its wrap when
# the checkout has no local clone in subprojects/.
#
# The libtsm commit compiled in is installed as /usr/share/doc/<pkgname>/libtsm-commit,
# so tier 3's guest log names the libtsm each run drew with (#38).
#
# fork/pkg/upstream/PKGBUILD sources this recipe to package upstream kmscon
# under other names for tier 3's comparison; the package functions take the
# names they install so both recipes share them.

pkgbase=kmscon-aaronsb
pkgname=(
  kmscon-aaronsb
  kmscon-aaronsb-terminfo
)
pkgver=${KMSCON_PKGVER:-10.0.4}
pkgrel=1
arch=('x86_64')
pkgdesc='Kernel Mode Setting (KMS) and DRM based virtual Console Emulator (aaronsb fork)'
url='https://github.com/aaronsb/kmscon'
license=('MIT')
depends=(
  bash
  dbus
  glib2
  glibc
  libdrm
  libpng
  libxkbcommon
  systemd-libs
  zlib
)
makedepends=(
  check
  docbook-xsl
  freetype2
  git
  harfbuzz
  libxslt
  linux-api-headers
  libglvnd
  meson
  pango
)
optdepends=(
  'fontconfig: for freetype font rendering'
  'harfbuzz: for freetype font rendering (cluster shaping)'
  'inotify-tools: for kmscon-launch-gui waiting mechanism'
  'libglvnd: for accelerated video output'
  'libx11: for XKB compose support'
  'pango: for pango font rendering'
)
options=(!debug)
source=()

_src=${KMSCON_SRC:-$startdir/../..}

prepare() {
  rm -rf kmscon
  mkdir kmscon
  # The checkout's build trees and VM images are not sources.
  tar -C "$_src" \
    --exclude=./.git --exclude=./fork/build --exclude=./fork/vm \
    --exclude=./subprojects/packagecache \
    -cf - . | tar -C kmscon -xf -
}

build() {
  meson setup kmscon build \
    --prefix /usr \
    --libexecdir lib \
    --sbindir bin \
    --buildtype plain \
    --auto-features enabled \
    -D b_pie=true \
    -D python.bytecompile=1 \
    -D images=enabled \
    --force-fallback-for=libtsm \
    -D libtsm:default_library=static
  _libtsm_commit > libtsm-commit
  meson compile -C build
}

# The commit of the libtsm tree meson configured: the copy of the checkout's
# subprojects/libtsm, which meson uses as it is, or the clone meson made from
# the wrap. The copy may have left its .git behind, so the checkout's own is
# read for it. "+dirty" marks a tree with changes or untracked files, other
# than the hash file meson writes into a wrap's checkout.
_libtsm_commit() {
  local d dirty
  for d in kmscon/subprojects/libtsm "$_src/subprojects/libtsm"; do
    if [ -e "$d/.git" ]; then
      dirty=$(git -C "$d" status --porcelain --untracked-files=all -- . \
        ':(exclude).meson-subproject-wrap-hash.txt')
      echo "$(git -C "$d" rev-parse HEAD)${dirty:++dirty}"
      return
    fi
  done
  echo unknown
}

check() {
  meson test -C build --print-errorlogs
}

package_kmscon-aaronsb() {
  _package_kmscon kmscon-aaronsb-terminfo
}

package_kmscon-aaronsb-terminfo() {
  _package_terminfo 'Terminfo for kmscon (aaronsb fork)'
}

# $1: the terminfo package the console depends on.
_package_kmscon() {
  depends+=("$1")
  provides=(kmscon)
  conflicts=(kmscon)
  meson install -C build --destdir="$pkgdir" --skip-subprojects
  install -Dm644 kmscon/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  install -Dm644 libtsm-commit "$pkgdir/usr/share/doc/$pkgname/libtsm-commit"
  rm -r "$pkgdir"/usr/share/terminfo
}

# $1: the package description.
_package_terminfo() {
  pkgdesc=$1
  depends=()
  optdepends=()
  provides=(kmscon-terminfo)
  conflicts=(kmscon-terminfo)
  mkdir -p "$pkgdir/usr/share/terminfo"
  tic -x kmscon/scripts/terminfo/kmscon.ti -o "$pkgdir/usr/share/terminfo/"
  install -Dm644 kmscon/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}

# Capability probes: NAME STATUS ISSUE NOTE (README.md beside this file).
# works: the probe must pass. missing: it must fail, and ISSUE tracks the gap:
# #N is aaronsb/kmscon#N, libtsm#N is aaronsb/libtsm#N.
# A missing probe that starts passing fails make test until it is set to works.

# the fork's own features (regression guards; see COVERAGE.md)
sgr-colon-subparams           works   -          colon sub-parameters: SGR reads them, other sequences with them are ignored (ADR-102)
sgr-underline-styles          works   -          SGR 4:1-4:5 and 21 set each underline style, 24 clears (ADR-102)
sgr-underline-colour          works   -          SGR 58;2 and 59; 4;58;5;196 never blinks (ADR-102)
sgr-strike                    works   -          SGR 9/29 (ADR-102)
sgr-blink                     works   -          SGR 5/25 set the frame blink flag kmscon draws (test_blink)
palette-at-draw               works   -          colours are resolved at draw time: a palette change recolours text
modkeys-not-sgr               works   -          CSI > 4;1 m and CSI ? 4 m are not SGR 4 (upstream c0733a5)
cluster                       works   -          a grapheme cluster is one cell whose codepoints read back
mode-2027                     works   -          mode 2027 and its DECRQM reply
vs16-width                    works   -          VS16 widens U+2764 to two cells under mode 2027
wide-at-margin                works   -          a wide character wraps whole at the margin (libtsm#12)
rep                           works   -          REP repeats the last printed character, a wide one whole
erase-colours-only            works   -          EL, SU, SD and RI blanks take the pen background only (libtsm#13)
frame-age-per-caller          works   -          tsm_screen_frame_since keeps each display's changes (libtsm#14)

# terminfo entry (scripts/terminfo/kmscon.ti) against what kmscon implements
terminfo-cursor-shape         works   -          Ss/Se for DECSCUSR
terminfo-italic               missing #94        sitm/ritm: SGR 3/23 are parsed (and drawn by pango)
terminfo-dim                  missing #94        dim: SGR 2 is implemented
terminfo-strike               missing #94        smxx/rmxx: SGR 9/29 are implemented (ADR-102)
terminfo-styled-underline     missing #94        Smulx: SGR 4:0-5 are implemented (ADR-102)
terminfo-underline-colour     missing #94        Setulc: SGR 58/59 are implemented (ADR-102)
terminfo-truecolor            works   -          Tc, setrgbf and setrgbb (upstream 114d109) for SGR 38;2 and 48;2
terminfo-setrgb               works   -          setrgbf and setrgbb expand with no empty final parameter, which xterm reads as SGR 0 (upstream 114d109 ends both in ";m")
terminfo-bracketed-paste      missing #94        BD/BE/PS/PE: mode 2004 is implemented
terminfo-sgr-mouse            missing #94        XM: mode 1006 is implemented; kmous alone selects X10 mouse
terminfo-sync                 works   -          Sync for mode 2026 (ADR-201 step 5)
terminfo-focus                missing libtsm#29  fe/fd, once mode 1004 exists
terminfo-clipboard            missing #106       Ms, once OSC 52 exists

# SGR
sgr-italic                    works   -          SGR 3/23 set and clear italic on the cell
sgr-truecolor                 works   -          SGR 38;2 and 48;2 direct colour
sgr-overline                  missing libtsm#27  SGR 53/55 (ECMA-48) are dropped
sgr-super-subscript           missing libtsm#26  SGR 73/74/75 (mintty) are dropped

# fonts (freetype backend, the default)
font-freetype-italic          missing #100       italic draws upright; pango slants it
font-freetype-synthetic-bold  missing #100       a family with no bold face draws bold as regular

# modes and reports
mode-2026-sync                works   -          synchronized output: DECRQM ?2026 replies 2, 1 in a hold; the bounded call stops at its end (ADR-201)
decrqm                        works   -          DECRQM answers every mode libtsm's mode table lists, 0 for the rest
da1                           works   -          CSI c replies CSI ? ... c
da1-level                     missing libtsm#31  DA1 reports level 60, not one of xterm's 61-65
da2                           works   -          CSI > c replies CSI > 1;1;0 c
da3                           missing libtsm#31  CSI = c is answered as DA1 (the = marker is not parsed)
xtversion                     missing libtsm#23  CSI > q gets no reply (and is taken as DECLL, clearing the LEDs)
xtgettcap                     missing libtsm#23  DCS + q is dropped

# OSC colours
osc-4-query                   works   -          OSC 4 ; n ; ? replies the palette colour
osc-4-set                     missing libtsm#22  OSC 4 ; n ; spec is parsed and discarded
osc-10-11-query               works   -          OSC 10/11 ; ? reply the default fg and bg
osc-10-11-set                 missing libtsm#22  OSC 10/11 ; spec are dropped
osc-12-query                  missing libtsm#22  OSC 12 (cursor colour) is dropped
osc-104-110-111-reset         missing libtsm#22  no reset, since nothing can be set

# keyboard
kitty-keyboard                missing libtsm#24  CSI ? u gets no reply; CSI > u and < u are dropped
modify-other-keys             missing libtsm#25  CSI > 4 ; n m is parsed (not taken as SGR 4) and ignored

# mouse and paste
mouse-1000                    works   -          normal tracking, X10 encoding
mouse-1006                    works   -          SGR encoding after 1000
mouse-1006-first              works   -          1006 set before 1000 still encodes the reports in SGR
mouse-1003-sgr                works   -          any-event motion in SGR
mouse-1003-x10                works   -          any-event motion with no button in the X10 encoding (32 + 35)
mouse-1016                    works   -          SGR pixel coordinates
bracketed-paste               works   -          mode 2004 wraps a paste in CSI 200~ / 201~
focus-1004                    missing libtsm#29  placeholder probe: mode 1004 is not recognised

# screen
reflow                        missing libtsm#28  widening the screen does not rejoin a wrapped line

# OSC features kmscon would handle (libtsm passes these through)
osc-8-hyperlink               missing #105       placeholder probe: OSC 8 is dropped
osc-52-clipboard              missing #106       placeholder probe: OSC 52 is dropped
osc-133-marks                 missing #107       placeholder probe: OSC 133 is dropped

# text
bidi                          missing #103       placeholder probe: no bidirectional text

# Audited without a probe: input methods (#111), braille displays (#112).
